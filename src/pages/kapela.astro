---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageTitle from '../components/PageTitle.astro';
import Video from '../components/Video.astro';
import { getAbout, getMembers, getVideos } from '../content';
import { bookingHref, vlna } from '../site';

const about = await getAbout();
const members = await getMembers();
const videos = await getVideos();
---

<Base
  page="kapela"
  title="Kapela"
  description={`Sestava a příběh kapely Exhalace (${about.home}). Kapela vznikla v roce ${about.founded}.`}
>
  <PageTitle title="Kapela" eyebrow={`Od roku ${about.founded}`}>
    <p class="lead">{vlna(about.lead)}</p>
  </PageTitle>

  <section class="section-tight wrap" aria-labelledby="lineup-title">
    <h2 id="lineup-title" class="sr-only">
      Sestava
    </h2>
    <ul class="members" data-reveal>
      {members.map((m) => (
        <li class="member card card--lift">
          <div class="member__photo">
            <Picture
              src={m.photo}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[320, 480, 720]}
              sizes="(width >= 76rem) 14rem, (width >= 36rem) 30vw, 45vw"
              alt={`${m.name}, ${m.role.toLowerCase()}`}
            />
          </div>
          <h3 class="member__name">{m.name}</h3>
          <p class="dim">{m.role}</p>
          {m.previously && <p class="meta">ex {m.previously}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap narrow" aria-labelledby="story-title">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Příběh</p>
      <h2 id="story-title" class="h2">
        Jak to celé začalo
      </h2>
    </div>
    <ol class="story glass" data-reveal>
      {about.story.map((s) => (
        <li class="story__item">
          <span class="logo-type story__year" aria-hidden={s.year ? undefined : 'true'}>
            {s.year ?? ''}
          </span>
          <p>{vlna(s.text)}</p>
        </li>
      ))}
    </ol>
  </section>

  {videos.length > 0 && (
    <section class="section wrap narrow" aria-labelledby="video-title">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Video</p>
        <h2 id="video-title" class="h2">
          Z YouTube
        </h2>
      </div>
      <div class="videos">
        {videos.map((v) => (
          <figure class="video-frame glass" data-reveal>
            <Video id={v.youtube} title={v.title} />
            <figcaption class="meta">
              {v.title} · {v.year}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section wrap narrow" aria-label="Poptávka">
    <div class="invite glass" data-reveal>
      <p class="h3">Chcete nás na své akci?</p>
      <a class="btn btn--solid" href={bookingHref}>
        Poptat koncert <Icon name="arrow-right" />
      </a>
    </div>
  </section>
</Base>

<style>
  .narrow {
    width: min(100%, 60rem);
  }

  .section-tight {
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .members {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 1rem;
  }

  .member {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding: 0.6rem 0.6rem 1.1rem;
    text-align: center;
  }

  .member__photo {
    aspect-ratio: 3 / 4;
    margin-bottom: 0.8rem;
    overflow: hidden;
    border-radius: calc(var(--radius) - 0.4rem);
  }

  .member__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .member:hover :global(img) {
    transform: scale(1.05);
  }

  .member__name {
    font-size: 1.1rem;
  }

  .story {
    display: grid;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .story__item {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
  }

  .story__item + .story__item {
    border-top: 1px solid var(--border);
  }

  .story__year {
    font-size: 1.9rem;
    line-height: 1.1;
    color: var(--accent);
  }

  .story__item p {
    color: var(--dim);
    text-wrap: pretty;
  }

  @media (width < 36rem) {
    .story__item {
      grid-template-columns: 1fr;
    }

    .story__year:empty {
      display: none;
    }
  }

  .videos {
    display: grid;
    gap: 1.5rem;
  }

  .video-frame {
    display: grid;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 1rem;
    text-align: center;
  }

  .video-frame :global(.video) {
    border-radius: calc(var(--radius-lg) - 0.5rem);
  }

  .invite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
