---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Video from '../components/Video.astro';
import { getAbout, getMembers, getVideos } from '../content';
import { bookingHref, vlna } from '../site';

const about = await getAbout();
const members = await getMembers();
const videos = await getVideos();
const story = about.story.map((s) => ({ ...s, text: vlna(s.text) }));
---

<Base
  page="kapela"
  title="Kapela"
  description={`Sestava a příběh kapely Exhalace (${about.home}). Kapela vznikla v roce ${about.founded}.`}
>
  <header class="page-head wrap">
    <h1 class="h1">Kapela</h1>
    <p class="lead">{vlna(about.lead)}</p>
  </header>

  <section class="section section--tight" aria-labelledby="lineup-title">
    <div class="wrap rail">
      <h2 id="lineup-title" class="rail__label label">
        Sestava
      </h2>
      <ul class="stage">
        {members.map((m, i) => (
          <li
            id={`clen-${i + 1}`}
            class:list={['member', m.stage && `member--${m.stage}`]}
            data-rise
          >
            <div class="member__photo">
              <Picture
                src={m.photo}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[320, 480, 720, 960]}
                sizes="(width >= 64rem) 22vw, 50vw"
                alt={`${m.name}, ${m.role.toLowerCase()}`}
              />
            </div>
            <h3 class="h3 member__name">{m.name}</h3>
            <p class="member__role">{m.role}</p>
            {m.previously && <p class="meta">ex {m.previously}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="story-title">
    <div class="wrap">
      <h2 id="story-title" class="h2 story__title">
        Příběh
      </h2>
      <ol class="story">
        {story.map((s) => (
          <li class="story__item" data-rise>
            <span class="stencil story__year" aria-hidden="true">
              {s.year ?? ''}
            </span>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {videos.length > 0 && (
    <section class="section section--tight" aria-labelledby="video-title">
      <div class="wrap">
        <h2 id="video-title" class="h2 story__title">
          Video
        </h2>
        <div class="videos">
          {videos.map((v) => (
            <figure class="videos__item">
              <Video id={v.youtube} title={v.title} />
              <figcaption class="meta">
                {v.title} · {v.year}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight" aria-label="Poptávka">
    <div class="wrap invite">
      <p class="h2">Chcete nás na své akci?</p>
      <a class="btn btn--lamp" href={bookingHref}>
        Poptat koncert <Icon name="arrow-right" />
      </a>
    </div>
  </section>
</Base>

<style>
  /* The line-up as a stage plot seen from the audience: drums at the back, three in front. */
  .stage {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-areas:
      '. . back back . .'
      'left left center center right right';
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .member--back {
    grid-area: back;
  }

  .member--left {
    grid-area: left;
  }

  .member--center {
    grid-area: center;
  }

  .member--right {
    grid-area: right;
  }

  /* Anyone without a stage spot falls into the free columns. */
  .member:not([class*='member--']) {
    grid-column: span 2;
  }

  .member {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }

  .member--back .member__photo {
    width: 85%;
    justify-self: center;
  }

  .member--back :is(.member__name, .member__role, .meta) {
    text-align: center;
  }

  .member__photo {
    aspect-ratio: 3 / 4;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .member__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition:
      filter var(--afterglow),
      transform 800ms var(--ease);
  }

  @media (hover: hover) {
    .member:hover :global(img) {
      filter: grayscale(0.2) contrast(1.05);
      transform: scale(1.03);
      transition-duration: 400ms, 800ms;
    }
  }

  .member__role {
    color: var(--tungsten);
    font-weight: 600;
  }

  @media (width < 48rem) {
    .stage {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: none;
    }

    .member,
    .member:not([class*='member--']) {
      grid-area: auto;
      grid-column: auto;
    }

    .member--back .member__photo {
      width: 100%;
    }

    .member--back :is(.member__name, .member__role, .meta) {
      text-align: left;
    }
  }

  .story__title {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .story {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .story__item {
    display: grid;
    grid-template-columns: minmax(6rem, 14rem) minmax(0, 44rem);
    gap: 0.5rem clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .story__year {
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    color: var(--tungsten);
  }

  .story__item p {
    color: var(--ash);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  @media (width < 40rem) {
    .story__item {
      grid-template-columns: 1fr;
    }

    .story__year:empty {
      display: none;
    }
  }

  .videos {
    display: grid;
    gap: 2rem;
    max-width: 60rem;
  }

  .videos__item {
    display: grid;
    gap: 0.75rem;
  }

  .invite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-block: 1px solid var(--line);
  }
</style>
