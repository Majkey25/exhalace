---
import Base from '../../layouts/Base.astro';
import ConcertCard from '../../components/ConcertCard.astro';
import Icon from '../../components/Icon.astro';
import PageTitle from '../../components/PageTitle.astro';
import { getConcerts, type Concert } from '../../content';
import { bookingHref, plural } from '../../site';

const { upcoming, past } = await getConcerts();
const years = [
  ...past
    .reduce((map, c) => {
      const year = c.date.slice(0, 4);
      return map.set(year, [...(map.get(year) ?? []), c]);
    }, new Map<string, Concert[]>())
    .entries(),
];
const count = ['koncert', 'koncerty', 'koncertů'] as const;
---

<Base
  page="koncerty"
  title="Koncerty"
  description="Kde a kdy hraje Exhalace: nadcházející koncerty s mapou a kalendářem a přehled odehraných akcí."
>
  <PageTitle title="Koncerty">
    <p class="lead">
      {upcoming.length ? (
        'Ke každému koncertu najdete mapu a soubor do kalendáře.'
      ) : (
        <>
          Nové termíny chystáme. Chcete nás na své akci?{' '}
          <a class="inline-link" href={bookingHref}>
            Ozvěte se nám
          </a>
        </>
      )}
    </p>
  </PageTitle>

  {upcoming.length > 0 && (
    <section class="section-tight wrap narrow" aria-label="Nadcházející koncerty">
      <ul class="list" data-reveal>
        {upcoming.map((c) => (
          <ConcertCard concert={c} />
        ))}
      </ul>
    </section>
  )}

  {years.length > 0 && (
    <section class="section wrap narrow" aria-labelledby="past-title">
      <div class="section-head" data-reveal>
        <h2 id="past-title" class="h2">
          Odehráli jsme
        </h2>
      </div>
      <div class="archive glass" data-reveal>
        {years.map(([year, list], i) => (
          <details class="year" open={i === 0}>
            <summary class="year__head">
              <span class="logo-type year__num">{year}</span>
              <span class="meta">{plural(list.length, count)}</span>
              <Icon name="chevron-down" class="year__chevron" />
            </summary>
            <ul class="list">
              {list.map((c) => (
                <ConcertCard concert={c} past />
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .narrow {
    width: min(100%, 60rem);
  }

  .section-tight {
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .list {
    display: grid;
    gap: 0.75rem;
  }

  .archive {
    padding: clamp(0.75rem, 2vw, 1.25rem);
  }

  .year + .year {
    border-top: 1px solid var(--border);
  }

  .year__head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.75rem;
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.3s var(--ease);
  }

  .year__head::-webkit-details-marker {
    display: none;
  }

  .year__head:hover {
    background: var(--surface);
  }

  .year__num {
    font-size: 1.9rem;
    line-height: 1;
  }

  .year__head :global(.year__chevron) {
    align-self: center;
    margin-left: auto;
    width: 1.25rem;
    height: 1.25rem;
    transition: rotate 0.35s var(--ease);
  }

  .year[open] :global(.year__chevron) {
    rotate: 180deg;
  }

  .year .list {
    padding: 0 0 0.75rem;
  }
</style>
