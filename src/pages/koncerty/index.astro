---
import Base from '../../layouts/Base.astro';
import ConcertRow from '../../components/ConcertRow.astro';
import Icon from '../../components/Icon.astro';
import { dateParts, getConcerts, type Concert } from '../../content';
import { bookingHref, plural, vlna } from '../../site';

const { upcoming, past } = await getConcerts();
const group = (list: Concert[], key: (c: Concert) => string) => {
  const map = new Map<string, Concert[]>();
  for (const c of list) map.set(key(c), [...(map.get(key(c)) ?? []), c]);
  return [...map];
};
const months = group(upcoming, (c) => {
  const d = dateParts(c.date);
  return `${d.month} ${d.year}`;
});
const years = group(past, (c) => c.date.slice(0, 4));
const count = ['koncert', 'koncerty', 'koncertů'] as const;
---

<Base
  page="koncerty"
  title="Koncerty"
  description="Kde a kdy hraje Exhalace: nadcházející koncerty s mapou a kalendářem a přehled odehraných akcí."
  extraMarks={['x']}
>
  <header class="page-head wrap">
    <h1 class="h1">Koncerty</h1>
    <p class="lead">
      {upcoming.length
        ? `${plural(upcoming.length, ['nadcházející koncert', 'nadcházející koncerty', 'nadcházejících koncertů'])}. Každý má mapu a soubor do kalendáře.`
        : vlna('Nové termíny chystáme. Sledujte nás, nebo si nás rovnou pozvěte na svou akci.')}
    </p>
  </header>

  {upcoming.length > 0 ? (
    <section class="section section--tight" aria-label="Nadcházející koncerty">
      <div class="wrap months">
        {months.map(([label, list]) => (
          <div class="rail">
            <h2 class="rail__label label">{label}</h2>
            <ul class="rows">
              {list.map((c) => (
                <ConcertRow concert={c} next={c === upcoming[0]} morph />
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ) : (
    <section class="section section--tight" aria-label="Poptávka">
      <div class="wrap">
        <div class="empty">
          <p class="h3">Zrovna nemáme vypsaný koncert.</p>
          <div class="actions">
            <a class="btn btn--lamp" href={bookingHref}>
              Pozvěte nás <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  {years.length > 0 && (
    <section class="section section--tight" aria-labelledby="past-title">
      <div class="wrap">
        <h2 id="past-title" class="h2 past__title">
          Odehráli jsme
        </h2>
        {years.map(([year, list], i) => (
          <details class="year" open={i === 0}>
            <summary class="year__head">
              <span class="stencil year__num">{year}</span>
              <span class="label">{plural(list.length, count)}</span>
            </summary>
            <ul class="rows">
              {list.map((c) => (
                <ConcertRow concert={c} past morph />
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .months {
    display: grid;
    gap: var(--gap-in);
  }

  .rows {
    border-top: 1px solid var(--line);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--line);
    background: var(--smoke);
  }

  .past__title {
    margin-bottom: 1.5rem;
  }

  .year {
    border-top: 1px solid var(--line);
  }

  .year__head {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .year__head::-webkit-details-marker {
    display: none;
  }

  .year__head::after {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    margin-left: auto;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: 45deg;
    transition: rotate var(--afterglow);
  }

  .year[open] .year__head::after {
    rotate: 225deg;
  }

  .year__num {
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    transition: color var(--afterglow);
  }

  .year__head:hover .year__num {
    color: var(--tungsten);
    transition-duration: 180ms;
  }
</style>
