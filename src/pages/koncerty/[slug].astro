---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ConcertCard from '../../components/ConcertCard.astro';
import Icon from '../../components/Icon.astro';
import {
  concertJsonLd,
  dateParts,
  getConcerts,
  mapUrl,
  statusLabel,
  type Concert,
} from '../../content';
import { bookingHref, href, vlna } from '../../site';

export async function getStaticPaths() {
  const { all, upcoming } = await getConcerts();
  return all.map((concert) => ({
    params: { slug: concert.slug },
    props: { concert, isPast: !upcoming.includes(concert), upcoming },
  }));
}

interface Props {
  concert: Concert;
  isPast: boolean;
  upcoming: Concert[];
}

const { concert: c, isPast, upcoming } = Astro.props;
const d = dateParts(c.date);
const site = Astro.site ?? new URL('https://www.exhalace.cz');
const url = new URL(href(`koncerty/${c.slug}/`), site).href;
const more = upcoming.filter((u) => u !== c).slice(0, 3);
const time = c.time && (c.end ? `${c.time}–${c.end}` : c.time);
const where = [c.venue, c.city].filter(Boolean).join(', ');
---

<Base
  page="koncerty"
  title={`${c.name}, ${d.short}`}
  description={`Exhalace ${isPast ? 'hrála' : 'hraje'} ${d.date}${c.time ? ` od ${c.time}` : ''}: ${where}.`}
>
  <article class="section wrap narrow" aria-labelledby="concert-title">
    <a class="link-arrow back" href={href('koncerty/')}>
      <Icon name="arrow-left" /> Všechny koncerty
    </a>

    <div class:list={['concert glass', { 'concert--poster': c.poster }]} data-reveal>
      <div class="concert__main">
        <p class="logo-type concert__date" aria-hidden="true">
          {d.numeric} {d.year}
        </p>
        <h1 id="concert-title" class="h2">
          {c.title ?? c.city}
        </h1>
        {c.status && <p class="concert__status">{statusLabel[c.status]}</p>}

        <dl class="facts">
          <div>
            <dt class="meta">Kdy</dt>
            <dd>
              <time datetime={c.time ? `${c.date}T${c.time}` : c.date}>{d.long}</time>
              {time && <span class="dim">{time}</span>}
            </dd>
          </div>
          <div>
            <dt class="meta">Kde</dt>
            <dd>
              {c.venue && <strong>{c.venue}</strong>}
              {c.address && <span class="dim">{c.address}</span>}
              <span class="dim">{c.city}</span>
            </dd>
          </div>
        </dl>

        {c.info && <p class="dim concert__info">{vlna(c.info)}</p>}

        <div class="actions">
          {!isPast && c.tickets && !c.inactive && (
            <a class="btn btn--solid" href={c.tickets} rel="noopener" target="_blank">
              <Icon name="ticket" /> Vstupenky
            </a>
          )}
          <a class="btn" href={mapUrl(c)} rel="noopener" target="_blank">
            <Icon name="pin" /> Navigovat
          </a>
          {!isPast && (
            <a
              class="btn btn--ghost"
              href={href(`koncerty/${c.slug}.ics`)}
              download={`exhalace-${c.slug}.ics`}
            >
              <Icon name="calendar" /> Do kalendáře
            </a>
          )}
          {isPast && (
            <a class="btn" href={bookingHref}>
              Pozvěte nás k sobě
            </a>
          )}
        </div>
      </div>

      {c.poster && (
        <figure class="concert__poster">
          <Picture
            src={c.poster}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[400, 700, 1000]}
            sizes="(width >= 56rem) 22rem, 100vw"
            alt={`Plakát: ${c.name}`}
            loading="eager"
          />
        </figure>
      )}
    </div>

    {more.length > 0 && (
      <section class="more" aria-labelledby="more-title">
        <h2 id="more-title" class="h3">
          Další koncerty
        </h2>
        <ul class="list">
          {more.map((m) => (
            <ConcertCard concert={m} />
          ))}
        </ul>
      </section>
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(concertJsonLd(c, url)).replace(/</g, '\\u003c')}
    />
  </article>
</Base>

<style>
  .narrow {
    width: min(100%, 60rem);
  }

  .back {
    min-height: 2.75rem;
    margin-bottom: 1.5rem;
  }

  .concert {
    display: grid;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .concert--poster {
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    align-items: start;
  }

  .concert__main {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .concert__date {
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    line-height: 1;
  }

  .concert__status {
    padding: 0.25rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .facts {
    display: grid;
    width: 100%;
    margin-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.25rem 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .facts dd {
    display: grid;
    gap: 0.1rem;
  }

  .facts dd time::first-letter {
    text-transform: uppercase;
  }

  .concert__info {
    max-width: 60ch;
  }

  .concert__main .actions {
    margin-top: 0.75rem;
  }

  .concert__poster {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .concert__poster :global(img) {
    width: 100%;
  }

  .more {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .list {
    display: grid;
    gap: 0.75rem;
  }

  @media (width < 48rem) {
    .concert--poster {
      grid-template-columns: 1fr;
    }
  }

  @media (width < 28rem) {
    .facts > div {
      grid-template-columns: 1fr;
    }
  }
</style>
