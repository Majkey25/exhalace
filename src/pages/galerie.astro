---
import { getImage, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getGallery } from '../content';

const gallery = await getGallery();
// Full-size copy for the lightbox; without JS the link simply opens it.
const photos = await Promise.all(
  gallery.map(async (p) => ({
    ...p,
    ratio: p.photo.width / p.photo.height,
    full: await getImage({
      src: p.photo,
      width: Math.min(p.photo.width, 2000),
      format: 'webp',
      quality: 80,
    }),
  })),
);
---

<Base
  page="galerie"
  title="Galerie"
  description="Fotky z koncertů kapely Exhalace: kluby, poutě i venkovní pódia."
>
  <header class="page-head wrap">
    <h1 class="h1">Galerie</h1>
    <p class="lead">Z klubů, hospod i z pódií pod širým nebem.</p>
  </header>

  <section class="section section--tight" aria-label="Fotky">
    <div class="wrap">
      <ul class="album">
        {photos.map((p, i) => (
          <li style={`--r: ${p.ratio.toFixed(3)}`}>
            <a
              class="album__shot"
              href={p.full.src}
              data-i={i}
              data-w={p.full.attributes.width}
              data-h={p.full.attributes.height}
            >
              <Picture
                src={p.photo}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[320, 480, 720, 960]}
                sizes={`(width >= 88rem) ${Math.round(16 * p.ratio)}rem, ${Math.round(24 * p.ratio)}vw`}
                alt={p.alt}
                loading={i < 4 ? 'eager' : 'lazy'}
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Fotka z galerie">
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
    <p class="lightbox__count label" aria-live="polite"></p>
    <button class="lightbox__btn lightbox__close" type="button" aria-label="Zavřít">
      <Icon name="close" />
    </button>
    <button class="lightbox__btn lightbox__prev" type="button" aria-label="Předchozí fotka">
      <Icon name="arrow-left" />
    </button>
    <button class="lightbox__btn lightbox__next" type="button" aria-label="Další fotka">
      <Icon name="arrow-right" />
    </button>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dialog?.querySelector<HTMLImageElement>('.lightbox__img');
  const caption = dialog?.querySelector('.lightbox__caption');
  const counter = dialog?.querySelector('.lightbox__count');
  const shots = [...document.querySelectorAll<HTMLAnchorElement>('.album__shot')];

  if (dialog && img && caption && counter && shots.length) {
    let index = 0;
    const show = (i: number) => {
      index = (i + shots.length) % shots.length;
      const shot = shots[index];
      if (!shot) return;
      const alt = shot.querySelector('img')?.alt ?? '';
      img.src = shot.href;
      img.width = Number(shot.dataset.w);
      img.height = Number(shot.dataset.h);
      img.alt = alt;
      caption.textContent = alt;
      counter.textContent = `${index + 1} / ${shots.length}`;
      // Warm the next photo so paging feels instant.
      const next = shots[(index + 1) % shots.length];
      if (next) new Image().src = next.href;
    };

    shots.forEach((shot, i) =>
      shot.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('.lightbox__prev')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lightbox__next')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());
    // A click on the dark backdrop (outside the photo) closes it.
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    dialog.addEventListener('pointerdown', (e) => (startX = e.clientX));
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  /* Justified rows, no cropping, file order kept (CSS only). */
  .album {
    --h: clamp(9rem, 24vw, 16rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .album li {
    flex: var(--r) 1 calc(var(--r) * var(--h));
    aspect-ratio: var(--r);
  }

  .album::after {
    content: '';
    flex: 999 1 0;
  }

  .album__shot {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--smoke);
  }

  .album__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms var(--ease);
  }

  /* The haze over each photo clears on hover. */
  .album__shot::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(20 17 15 / 0.5), transparent 55%);
    transition:
      transform 800ms var(--ease),
      opacity 800ms var(--ease);
  }

  @media (hover: hover) {
    .album__shot:hover :global(img) {
      transform: scale(1.035);
    }

    .album__shot:hover::after {
      opacity: 0;
      transform: translateY(-35%);
    }
  }

  .album__shot:focus-visible {
    outline-offset: -3px;
  }

  /* ---------- Lightbox ---------- */

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(0.5rem, 5vw, 5rem) 3rem;
    border: 0;
    background: transparent;
    color: var(--bone);
    overflow: hidden;
    opacity: 0;
    transition:
      opacity 0.35s var(--ease),
      display 0.35s allow-discrete,
      overlay 0.35s allow-discrete;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    opacity: 1;
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
    }
  }

  .lightbox::backdrop {
    background: rgb(20 17 15 / 0.96);
  }

  .lightbox__figure {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 100%;
    max-height: 100%;
  }

  .lightbox__img {
    width: auto;
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    object-fit: contain;
    scale: 1;
    transition: scale 0.35s var(--ease);
  }

  @starting-style {
    .lightbox[open] .lightbox__img {
      scale: 0.97;
    }
  }

  .lightbox__caption {
    max-width: 60ch;
    color: var(--ash);
    text-align: center;
  }

  .lightbox__count {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1.5px solid var(--line);
    border-radius: 50%;
    background: rgb(20 17 15 / 0.6);
    transition:
      color var(--afterglow),
      border-color var(--afterglow);
  }

  .lightbox__btn:hover {
    color: var(--tungsten);
    border-color: var(--tungsten);
    transition-duration: 180ms;
  }

  .lightbox__btn :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__prev {
    left: 0.75rem;
  }

  .lightbox__next {
    right: 0.75rem;
  }

  @media (width < 40rem) {
    /* Phones: arrows sit at the bottom, so the photo and caption leave room for them. */
    .lightbox {
      padding-bottom: 4.5rem;
    }

    .lightbox__img {
      max-height: calc(100dvh - 13rem);
    }

    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 0.75rem;
      translate: none;
    }
  }
</style>
