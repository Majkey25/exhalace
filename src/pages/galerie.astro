---
import { getImage, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageTitle from '../components/PageTitle.astro';
import { getGallery } from '../content';

const gallery = await getGallery();
// Full-size copy for the lightbox; without JS the link simply opens it.
const photos = await Promise.all(
  gallery.map(async (p) => ({
    ...p,
    full: await getImage({
      src: p.photo,
      width: Math.min(p.photo.width, 2000),
      format: 'webp',
      quality: 80,
    }),
  })),
);
---

<Base
  page="galerie"
  title="Galerie"
  description="Fotky z koncertů kapely Exhalace: kluby, poutě i venkovní pódia."
>
  <PageTitle title="Galerie">
    <p class="lead">Momentky z našeho fungování.</p>
  </PageTitle>

  <section class="section-tight wrap" aria-label="Fotky">
    <ul class="tiles">
      {photos.map((p, i) => (
        <li>
          <a
            class="tile"
            href={p.full.src}
            data-w={p.full.attributes.width}
            data-h={p.full.attributes.height}
          >
            <Picture
              src={p.photo}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[320, 480, 720]}
              sizes="(width >= 76rem) 18rem, (width >= 48rem) 30vw, 45vw"
              alt={p.alt}
              loading={i < 8 ? 'eager' : 'lazy'}
            />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <dialog class="lightbox" aria-label="Fotka z galerie">
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
    <p class="lightbox__count meta" aria-live="polite"></p>
    <button class="lightbox__btn lightbox__close" type="button" aria-label="Zavřít">
      <Icon name="close" />
    </button>
    <button class="lightbox__btn lightbox__prev" type="button" aria-label="Předchozí fotka">
      <Icon name="arrow-left" />
    </button>
    <button class="lightbox__btn lightbox__next" type="button" aria-label="Další fotka">
      <Icon name="arrow-right" />
    </button>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dialog?.querySelector<HTMLImageElement>('.lightbox__img');
  const caption = dialog?.querySelector('.lightbox__caption');
  const counter = dialog?.querySelector('.lightbox__count');
  const shots = [...document.querySelectorAll<HTMLAnchorElement>('.tile')];

  if (dialog && img && caption && counter && shots.length) {
    let index = 0;
    const show = (i: number) => {
      index = (i + shots.length) % shots.length;
      const shot = shots[index];
      if (!shot) return;
      const alt = shot.querySelector('img')?.alt ?? '';
      img.src = shot.href;
      img.width = Number(shot.dataset.w);
      img.height = Number(shot.dataset.h);
      img.alt = alt;
      caption.textContent = alt;
      counter.textContent = `${index + 1} / ${shots.length}`;
      // Warm the next photo so paging feels instant.
      const next = shots[(index + 1) % shots.length];
      if (next) new Image().src = next.href;
    };

    shots.forEach((shot, i) =>
      shot.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('.lightbox__prev')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lightbox__next')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());
    let startX = 0;
    let swiped = false;
    // A click on the dark backdrop (outside the photo) closes it, unless it ends a swipe.
    dialog.addEventListener('click', (e) => e.target === dialog && !swiped && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    dialog.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      swiped = false;
    });
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      swiped = Math.abs(dx) > 50;
      if (swiped) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .section-tight {
    padding-bottom: var(--section);
  }

  /* Rounded square tiles like the first site, with a gentle zoom. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }

  .tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(to top, rgb(0 0 0 / 0.35), transparent 50%);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  @media (hover: hover) {
    .tile:hover :global(img) {
      transform: scale(1.06);
    }

    .tile:hover::after {
      opacity: 1;
    }
  }

  .tile:focus-visible {
    outline-offset: 3px;
  }

  /* ---------- Lightbox ---------- */

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(0.5rem, 5vw, 5rem) 3rem;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: hidden;
    /* Horizontal touch drags reach the swipe handler instead of cancelling it. */
    touch-action: pan-y pinch-zoom;
    opacity: 0;
    transition:
      opacity 0.35s var(--ease),
      display 0.35s allow-discrete,
      overlay 0.35s allow-discrete;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    opacity: 1;
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
    }
  }

  .lightbox::backdrop {
    background: rgb(5 5 5 / 0.94);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .lightbox__figure {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 100%;
    max-height: 100%;
  }

  .lightbox__img {
    width: auto;
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    object-fit: contain;
    border-radius: var(--radius);
    scale: 1;
    transition: scale 0.35s var(--ease);
  }

  @starting-style {
    .lightbox[open] .lightbox__img {
      scale: 0.97;
    }
  }

  .lightbox__caption {
    max-width: 60ch;
    color: var(--dim);
    text-align: center;
  }

  .lightbox__count {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: rgb(13 13 13 / 0.6);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .lightbox__btn:hover {
    background: #fff;
    color: #0d0d0d;
  }

  .lightbox__btn :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__prev {
    left: 0.75rem;
  }

  .lightbox__next {
    right: 0.75rem;
  }

  @media (width < 40rem) {
    /* Phones: arrows sit at the bottom, so the photo and caption leave room for them. */
    .lightbox {
      padding-bottom: 4.5rem;
    }

    .lightbox__img {
      max-height: calc(100dvh - 13rem);
    }

    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 0.75rem;
      translate: none;
    }
  }
</style>
