---
import Base from '../layouts/Base.astro';
import { href } from '../site';
---

<Base title="Stránka nenalezena" description="Tahle stránka neexistuje." noindex>
  <section class="section wrap">
    <div class="lost glass">
      <p class="logo-type lost__code" aria-hidden="true">
        404
      </p>
      <h1 class="h2">Tahle stránka tu není</h1>
      <p class="lead">Stránka, kterou hledáte, neexistuje nebo se přestěhovala.</p>
      <div class="actions">
        <a class="btn" href={href('koncerty/')}>
          Koncerty
        </a>
        <a class="btn" href={href()}>
          Úvod
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    text-align: center;
  }

  .lost__code {
    font-size: clamp(5rem, 3rem + 10vw, 9rem);
    line-height: 1;
  }

  .lost .actions {
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
