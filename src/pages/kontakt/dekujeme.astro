---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { href } from '../../site';
---

<Base title="Poptávka odeslána" description="Díky, poptávka dorazila." noindex>
  <section class="section">
    <div class="wrap thanks">
      <h1 class="h1">Díky!</h1>
      <p class="lead">Poptávka dorazila. Ozveme se co nejdřív.</p>
      <div class="actions">
        <a class="btn btn--lamp" href={href('koncerty/')}>
          Koncerty <Icon name="arrow-right" />
        </a>
        <a class="btn" href={href()}>
          Úvod
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }
</style>
