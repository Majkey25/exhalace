---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { href } from '../../site';
---

<Base title="Poptávka odeslána" description="Díky, poptávka dorazila." noindex>
  <section class="section wrap">
    <div class="thanks glass">
      <p class="eyebrow">Hotovo</p>
      <h1 class="title">Díky!</h1>
      <p class="lead">Poptávka dorazila. Ozveme se co nejdřív.</p>
      <div class="actions">
        <a class="btn btn--solid" href={href('koncerty/')}>
          Koncerty <Icon name="arrow-right" />
        </a>
        <a class="btn" href={href()}>
          Úvod
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    text-align: center;
  }

  .thanks .actions {
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
