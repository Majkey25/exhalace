---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageTitle from '../../components/PageTitle.astro';
import { getAbout, getSettings } from '../../content';
import { href, vlna } from '../../site';

const settings = await getSettings();
const about = await getAbout();
const tel = settings.phone?.replace(/\s/g, '');
const rider = settings.organisers
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const socials = (
  [
    { name: 'Facebook', url: settings.facebook, icon: 'facebook' },
    { name: 'Instagram', url: settings.instagram, icon: 'instagram' },
    { name: 'YouTube', url: settings.youtube, icon: 'youtube' },
  ] as const
).filter((s): s is typeof s & { url: string } => Boolean(s.url));
const site = Astro.site ?? new URL('https://www.exhalace.cz');
// Without JS the browser posts the form and FormSubmit sends the visitor to the thank-you page.
const next = new URL(href('kontakt/dekujeme/'), site).href;
const types = [
  'Hospoda nebo bar',
  'Pouť, hody, slavnost obce',
  'Hasičská oslava',
  'Ples nebo zábava',
  'Soukromá oslava',
  'Něco jiného',
];
// OpenStreetMap embed around the band's home (no script, loads only when scrolled to).
const { map_lat: lat, map_lng: lng } = settings;
const map =
  lat !== undefined && lng !== undefined
    ? `https://www.openstreetmap.org/export/embed.html?bbox=${lng - 0.04},${lat - 0.018},${lng + 0.04},${lat + 0.018}&layer=mapnik&marker=${lat},${lng}`
    : undefined;
---

<Base
  page="kontakt"
  title="Kontakt"
  description="Objednejte si kapelu Exhalace: telefon, e-mail, poptávkový formulář a technické informace pro pořadatele."
>
  <PageTitle title="Kontakt">
    <p class="lead">{vlna('Máte dotazy? Chcete si s námi domluvit koncert? Ozvěte se nám!')}</p>
  </PageTitle>

  <section class="section-tight wrap narrow" aria-label="Přímý kontakt">
    <ul class="direct" data-reveal>
      {tel && (
        <li>
          <a class="card card--lift direct__item" href={`tel:${tel}`}>
            <Icon name="phone" />
            <span class="meta">Telefon</span>
            <span class="direct__value">{settings.phone}</span>
          </a>
        </li>
      )}
      <li>
        <a class="card card--lift direct__item" href={`mailto:${settings.email}`}>
          <Icon name="mail" />
          <span class="meta">E-mail</span>
          <span class="direct__value">{settings.email}</span>
        </a>
      </li>
      <li class="card direct__item">
        <span class="meta">Sledujte nás</span>
        <span class="direct__socials">
          {socials.map((s) => (
            <a href={s.url} rel="noopener" target="_blank" aria-label={s.name}>
              <Icon name={s.icon} />
            </a>
          ))}
        </span>
      </li>
    </ul>
  </section>

  <section class="section-tight wrap" aria-label="Poptávka a technické informace">
    <div class="booking">
      <form
        id="poptavka"
        class="form glass"
        action={`https://formsubmit.co/${settings.email}`}
        method="POST"
        data-endpoint={`https://formsubmit.co/ajax/${settings.email}`}
        data-reveal
      >
        <div>
          <h2 class="h3">Chcete nás na své akci?</h2>
        </div>
        <div class="form__row">
          <label class="field">
            <span>Jméno *</span>
            <input name="name" autocomplete="name" required maxlength="100" />
          </label>
          <label class="field">
            <span>E-mail *</span>
            <input type="email" name="email" autocomplete="email" required maxlength="200" />
          </label>
        </div>
        <div class="form__row">
          <label class="field">
            <span>Telefon</span>
            <input type="tel" name="phone" autocomplete="tel" maxlength="30" />
          </label>
          <label class="field">
            <span>Datum akce</span>
            <input type="date" name="date" />
          </label>
        </div>
        <div class="form__row">
          <label class="field">
            <span>Obec a místo</span>
            <input name="place" maxlength="150" />
          </label>
          <label class="field">
            <span>Typ akce</span>
            <select name="type">
              {types.map((t) => (
                <option>{t}</option>
              ))}
            </select>
          </label>
        </div>
        <label class="field">
          <span>Zpráva *</span>
          <textarea
            name="message"
            rows="5"
            required
            maxlength="5000"
            placeholder="Kde, kdy, jak dlouho, venku nebo uvnitř, máte vlastní ozvučení?"
          ></textarea>
        </label>
        <input
          class="form__trap"
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <input type="hidden" name="_subject" value="Poptávka z webu exhalace.cz" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={next} />
        <div class="form__foot">
          <button class="btn btn--solid" type="submit">
            Odeslat poptávku
          </button>
          <p class="meta">
            {vlna('Zprávu doručí služba FormSubmit na náš e-mail. Údaje použijeme jen k odpovědi.')}
          </p>
        </div>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>

      <aside id="technika" class="rider glass" aria-labelledby="rider-title" data-reveal>
        <div class="rider__head">
          <div>
            <h2 id="rider-title" class="h3">
              Pro pořadatele
            </h2>
          </div>
          <button class="btn btn--ghost rider__print no-print" type="button" data-print>
            <Icon name="printer" /> Tisk
          </button>
        </div>
        <ul class="rider__list">
          {rider.map((p) => (
            <li>{vlna(p)}</li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {map && (
    <section class="section wrap narrow no-print" aria-labelledby="map-title">
      <div class="section-head" data-reveal>
        <h2 id="map-title" class="h2">
          Kde nás najdete?
        </h2>
        <p class="dim">{about.home}</p>
      </div>
      {/* The iframe is added only when the map scrolls near, so it never competes with the page. */}
      <div class="map glass" data-reveal data-map={map} data-title={`Mapa: ${about.home}`}></div>
      <p class="map__credit">
        <a
          class="link-arrow"
          href={`https://mapy.com/fnc/v1/showmap?center=${lng},${lat}&zoom=13&marker=true`}
          rel="noopener"
          target="_blank"
        >
          Otevřít v Mapy.com <Icon name="external" />
        </a>
      </p>
    </section>
  )}
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => print());

  const mapBox = document.querySelector<HTMLElement>('[data-map]');
  if (mapBox) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        const frame = document.createElement('iframe');
        frame.src = mapBox.dataset.map ?? '';
        frame.title = mapBox.dataset.title ?? 'Mapa';
        mapBox.append(frame);
        io.disconnect();
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(mapBox);
  }

  const form = document.querySelector<HTMLFormElement>('#poptavka');
  const status = form?.querySelector('.form__status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (form && status && button) {
    const say = (text: string, ok: boolean) => {
      status.textContent = text;
      status.classList.toggle('is-error', !ok);
    };
    const sent = 'Díky, poptávka dorazila. Ozveme se co nejdřív.';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      // Bots fill every field; people never see this one. Pretend it worked.
      if (data._honey) return say(sent, true);
      delete data._honey;
      delete data._next;
      data._subject = `Poptávka z webu: ${data.type}${data.place ? `, ${data.place}` : ''}${data.date ? `, ${data.date}` : ''}`;
      data._replyto = data.email ?? '';
      const label = button.innerHTML;
      button.disabled = true;
      button.textContent = 'Odesílám…';
      try {
        const res = await fetch(form.dataset.endpoint ?? form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const body = (await res.json().catch(() => ({}))) as { success?: string | boolean };
        if (!res.ok || String(body.success) !== 'true') throw new Error(`status ${res.status}`);
        form.reset();
        say(sent, true);
      } catch {
        say('Odeslání se nepovedlo. Zavolejte nám, nebo napište na e-mail výše.', false);
      } finally {
        button.disabled = false;
        button.innerHTML = label;
      }
    });
  }
</script>

<style>
  .narrow {
    width: min(100%, 60rem);
  }

  .section-tight {
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .direct {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }

  .direct > li {
    display: grid;
  }

  .direct__item {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.35rem;
    padding: 1.5rem 1.25rem;
    text-align: center;
  }

  .direct__item > :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
    margin-bottom: 0.25rem;
    color: var(--accent);
  }

  .direct__value {
    font-size: 1.15rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .direct__socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }

  .direct__socials a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .direct__socials a:hover {
    background: #fff;
    color: #0d0d0d;
  }

  .direct__socials :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .booking {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .form,
  .rider {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.8rem;
    background: rgb(0 0 0 / 0.3);
    font-size: 1rem;
    font-weight: 400;
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .field select option {
    background: #111;
  }

  .field textarea {
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--faint);
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: rgb(255 255 255 / 0.4);
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: #fff;
    background: rgb(0 0 0 / 0.45);
    outline-offset: 1px;
  }

  .field :user-invalid {
    border-color: var(--error);
  }

  .form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  .form__foot .meta {
    flex: 1 1 14rem;
  }

  .form__foot .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .form__status:not(:empty) {
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.8rem;
    background: var(--surface);
  }

  .form__status.is-error {
    border-color: var(--error);
    color: var(--error);
  }

  .rider__head {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .rider__print {
    min-height: 2.75rem;
    padding: 0.4rem 1rem;
    font-size: 0.9rem;
  }

  .rider__list {
    display: grid;
    gap: 0.85rem;
    color: var(--dim);
  }

  .rider__list li {
    position: relative;
    padding-left: 1.4rem;
  }

  .rider__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .map {
    padding: 0.5rem;
    overflow: hidden;
  }

  .map {
    min-height: calc(clamp(18rem, 40vw, 26rem) + 1rem);
  }

  .map :global(iframe) {
    width: 100%;
    height: clamp(18rem, 40vw, 26rem);
    border: 0;
    border-radius: calc(var(--radius-lg) - 0.5rem);
    filter: grayscale(0.6) contrast(1.05);
  }

  .map__credit {
    margin-top: 0.75rem;
    text-align: center;
  }

  @media (width < 56rem) {
    .booking {
      grid-template-columns: 1fr;
    }
  }

  @media (width < 30rem) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .direct,
    .form {
      display: none;
    }
  }
</style>
