---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ConcertCard from '../components/ConcertCard.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import Video from '../components/Video.astro';
import {
  dateParts,
  getAbout,
  getConcerts,
  getGallery,
  getMembers,
  getSettings,
  getVideos,
} from '../content';
import { bookingHref, href, vlna } from '../site';

const settings = await getSettings();
const about = await getAbout();
const members = await getMembers();
const photos = (await getGallery()).slice(0, 6);
const [video] = await getVideos();
const { upcoming, past } = await getConcerts();
// A cancelled or postponed date is never advertised as the next gig.
const next = upcoming.find((c) => !c.inactive);
const d = next && dateParts(next.date);
const tel = settings.phone?.replace(/\s/g, '');
---

<Base page="home" intro>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media" aria-hidden="true">
      <Picture
        src={settings.hero}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 960, 1280, 1600, 2048]}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__inner wrap">
      <h1 id="hero-title" class="hero__title">
        <Mark name="logo" class="hero__logo" label="Exhalace" />
        <span class="hero__slogan">{settings.slogan}</span>
      </h1>
      <p class="lead hero__lead">{vlna(about.lead)}</p>
      <div class="actions hero__actions">
        <a class="btn btn--solid" href={href('koncerty/')}>
          Koncerty
        </a>
        <a class="btn" href={bookingHref}>
          Poptat koncert
        </a>
      </div>
      {next && d && (
        <a class="hero__next" href={href(`koncerty/${next.slug}/`)}>
          <span class="eyebrow">Příště hrajeme</span>
          <span class="logo-type hero__next-date">{d.numeric}</span>
          <span>
            {[next.title ?? next.city, next.venue].filter(Boolean).join(' · ')}
            {next.time && ` · ${next.time}`}
          </span>
          <Icon name="arrow-right" />
        </a>
      )}
    </div>
    <a class="hero__scroll" href="#kapela" aria-label="Dolů na obsah">
      <Icon name="chevron-down" />
    </a>
  </section>

  <section id="kapela" class="section" aria-labelledby="band-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">O kapele</p>
        <h2 id="band-title" class="h2">
          Kdo jsme
        </h2>
        <p class="lead">{vlna(about.story[0]?.text ?? about.lead)}</p>
      </div>
      <ul class="members" data-reveal>
        {members.map((m) => (
          <li class="member card card--lift">
            <div class="member__photo">
              <Picture
                src={m.photo}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[240, 360, 480]}
                sizes="(width >= 64rem) 14rem, (width >= 36rem) 30vw, 45vw"
                alt=""
              />
            </div>
            <p class="member__name">{m.name}</p>
            <p class="meta">{m.role}</p>
          </li>
        ))}
      </ul>
      <div class="section-foot">
        <a class="btn btn--ghost" href={href('kapela/')}>
          Celý příběh kapely <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="concerts-title">
    <div class="wrap narrow">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Koncerty</p>
        <h2 id="concerts-title" class="h2">
          {upcoming.length ? 'Kde nás uslyšíte' : 'Naposledy jsme hráli'}
        </h2>
      </div>
      {upcoming.length === 0 && (
        <div class="empty glass" data-reveal>
          <p class="h3">Nové termíny chystáme</p>
          <p class="dim">{vlna('Chcete nás na své akci? Napište nebo zavolejte, domluvíme se.')}</p>
          <a class="btn btn--solid" href={bookingHref}>
            Poptat koncert
          </a>
        </div>
      )}
      <ul class="concerts" data-reveal>
        {(upcoming.length ? upcoming.slice(0, 3) : past.slice(0, 3)).map((c) => (
          <ConcertCard concert={c} next={c === next} past={!upcoming.length} />
        ))}
      </ul>
      <div class="section-foot">
        <a class="link-arrow" href={href('koncerty/')}>
          Všechny koncerty <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  {video && (
    <section class="section" aria-labelledby="video-title">
      <div class="wrap narrow">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Video</p>
          <h2 id="video-title" class="h2">
            {video.title}
          </h2>
        </div>
        <div class="video-frame glass" data-reveal>
          <Video id={video.youtube} title={video.title} />
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="gallery-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Galerie</p>
        <h2 id="gallery-title" class="h2">
          Momentky z koncertů
        </h2>
      </div>
      <ul class="tiles" data-reveal>
        {photos.map((p) => (
          <li class="tile">
            <Picture
              src={p.photo}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[320, 480, 720]}
              sizes="(width >= 64rem) 24rem, (width >= 36rem) 45vw, 90vw"
              alt={p.alt}
            />
          </li>
        ))}
      </ul>
      <div class="section-foot">
        <a class="btn btn--ghost" href={href('galerie/')}>
          Celá galerie <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="book-title">
    <div class="wrap narrow">
      <div class="book glass" data-reveal>
        <p class="eyebrow">Pro pořadatele</p>
        <h2 id="book-title" class="h2">
          Chcete nás na své akci?
        </h2>
        <p class="lead">
          {vlna(
            'Nabízíme energickou a poctivou show na každou akci. Pódiový aparát včetně bicích vozíme vlastní, na všem ostatním se domluvíme.',
          )}
        </p>
        <div class="actions">
          <a class="btn btn--solid" href={bookingHref}>
            Poptat koncert
          </a>
          {tel && (
            <a class="btn" href={`tel:${tel}`}>
              <Icon name="phone" /> {settings.phone}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: max(100svh, 38rem);
    padding-block: calc(var(--header-h) + 3rem) 5rem;
    text-align: center;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  /* Darkened like the first site's hero, fading into the page colour at the bottom. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(5 5 5 / 0.55), rgb(5 5 5 / 0.55) 55%, var(--bg)),
      radial-gradient(ellipse at 50% 45%, transparent 20%, rgb(5 5 5 / 0.55) 90%);
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__media :global(img) {
        animation: hero-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }

  /* A slow push-in while the page scrolls away. */
  @keyframes hero-drift {
    to {
      transform: scale(1.08) translateY(3%);
    }
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  .hero__title {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }

  .hero__title :global(.hero__logo) {
    width: min(88vw, 46rem);
    height: auto;
    color: #fff;
    filter: drop-shadow(0 0.5rem 2rem rgb(0 0 0 / 0.5));
  }

  .hero__slogan {
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .hero__lead {
    max-width: 40rem;
  }

  .hero__actions {
    justify-content: center;
  }

  .hero__next {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(13 13 13 / 0.6);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: border-color 0.3s var(--ease);
  }

  .hero__next:hover {
    border-color: var(--border-strong);
  }

  .hero__next-date {
    font-size: 1.35rem;
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    translate: -50% 0;
    animation: nudge 2.4s var(--ease) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.35rem);
    }
  }

  /* ---------- Sections ---------- */

  .narrow {
    width: min(100%, 60rem);
  }

  .members {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 1rem;
  }

  .member {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding: 0.6rem 0.6rem 1rem;
    text-align: center;
  }

  .member__photo {
    aspect-ratio: 3 / 4;
    margin-bottom: 0.75rem;
    overflow: hidden;
    border-radius: calc(var(--radius) - 0.4rem);
  }

  .member__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .member:hover :global(img) {
    transform: scale(1.05);
  }

  .member__name {
    font-weight: 700;
  }

  .concerts {
    display: grid;
    gap: 0.75rem;
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    text-align: center;
  }

  .video-frame {
    padding: 0.5rem;
    overflow: hidden;
  }

  .video-frame :global(.video) {
    border-radius: calc(var(--radius-lg) - 0.5rem);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (width < 40rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }
  }

  .tile {
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .tile:hover :global(img) {
    transform: scale(1.06);
  }

  .book {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 0%, rgb(255 79 132 / 0.12), transparent 60%), var(--surface);
  }

  .book .lead {
    max-width: 38rem;
  }

  .book .actions {
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
