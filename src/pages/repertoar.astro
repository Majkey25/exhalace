---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getRepertoire, getSettings, repertoireSummary, slugify as slug } from '../content';
import { bookingHref } from '../site';

const repertoire = await getRepertoire();
const settings = await getSettings();
// Poster sizes: the more songs by an artist, the bigger the name.
const size = (n: number) => (n >= 4 ? 'xl' : n >= 2 ? 'l' : 'm');
const summary = repertoireSummary(repertoire);
---

<Base
  page="repertoar"
  title="Repertoár"
  description={`Co Exhalace hraje: ${summary}, předělávky českých a slovenských rockových a punkových kapel. Seznam k tisku pro pořadatele.`}
>
  <header class="page-head wrap">
    <h1 class="h1">Repertoár</h1>
    <p class="lead">{summary}. A další pecky pro vás připravujeme…</p>
    <div class="actions no-print head-actions">
      <button class="btn" type="button" data-print>
        <Icon name="printer" /> Vytisknout
      </button>
      <a class="btn btn--lamp" href={bookingHref}>
        Poptat koncert <Icon name="arrow-right" />
      </a>
    </div>
  </header>

  <section class="section section--tight no-print" aria-label="Interpreti">
    <div class="wrap">
      <ul class="lineup">
        {repertoire.map((a) => (
          <li>
            <a
              class:list={['lineup__name', `lineup__name--${size(a.songs.length)}`]}
              href={`#${slug(a.artist)}`}
            >
              {a.artist}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="list-title">
    <div class="wrap">
      <div class="sheet songs">
        <div class="songs__head">
          <h2 id="list-title" class="h2">
            Seznam písní
          </h2>
          <label class="search no-print" hidden>
            <span class="label">Hledat píseň nebo kapelu</span>
            <span class="search__field">
              <Icon name="search" />
              <input type="search" autocomplete="off" spellcheck="false" />
            </span>
          </label>
          <p class="songs__count label" aria-live="polite"></p>
        </div>
        <div class="songs__groups">
          {repertoire.map((a) => (
            <section class="group" id={slug(a.artist)} aria-labelledby={`g-${slug(a.artist)}`}>
              <h3 id={`g-${slug(a.artist)}`} class="group__artist">
                {a.artist}
              </h3>
              <ul>
                {a.songs.map((s) => (
                  <li class="song" data-q={`${s} ${a.artist}`}>
                    {s}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="songs__empty" hidden>
          Nic takového nehrajeme. Zkuste jiný název.
        </p>
        <p class="songs__print">
          Objednávky: {settings.phone} · {settings.email} · www.exhalace.cz
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Print button and a diacritics-insensitive filter: "zizen" finds "Žízeň".
  document.querySelector('[data-print]')?.addEventListener('click', () => print());

  const search = document.querySelector<HTMLLabelElement>('.search');
  const input = search?.querySelector('input');
  const count = document.querySelector('.songs__count');
  const empty = document.querySelector<HTMLElement>('.songs__empty');
  const groups = [...document.querySelectorAll<HTMLElement>('.group')];
  const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const songs = [...document.querySelectorAll<HTMLElement>('.song')].map((el) => ({
    el,
    q: fold(el.dataset.q ?? ''),
  }));

  if (search && input && count && empty) {
    search.hidden = false;
    let timer = 0;
    input.addEventListener('input', () => {
      const q = fold(input.value.trim());
      let shown = 0;
      for (const s of songs) {
        const hit = !q || s.q.includes(q);
        s.el.hidden = !hit;
        if (hit) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector('.song:not([hidden])');
      empty.hidden = shown > 0;
      // Announce the count once typing pauses, not on every key.
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        count.textContent = q ? `Nalezeno: ${shown}` : '';
      }, 400);
    });
  }
</script>

<style>
  .head-actions {
    margin-top: 2rem;
  }

  /* Every covered band set like a festival poster line-up. */
  .lineup {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1.4rem;
  }

  .lineup__name {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    color: var(--ash);
    transition: color var(--afterglow);
  }

  .lineup__name:hover,
  .lineup__name:focus-visible {
    color: var(--tungsten);
    transition-duration: 180ms;
  }

  .lineup__name--xl {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    color: var(--bone);
  }

  .lineup__name--l {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem);
    color: var(--bone);
  }

  .lineup__name--m {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .songs__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-bottom: 2rem;
  }

  .search {
    display: grid;
    gap: 0.5rem;
    width: min(100%, 22rem);
  }

  .search[hidden] {
    display: none;
  }

  .search__field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-inline: 0.9rem;
    border: 1.5px solid var(--ink-muted);
    background: #f6f1e8;
  }

  .search__field:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .search input {
    width: 100%;
    min-height: 3rem;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 1.0625rem;
    outline: none;
  }

  .songs__count {
    width: 100%;
    min-height: 1.2em;
  }

  .songs__groups {
    columns: 17rem;
    column-gap: 2.5rem;
  }

  .group {
    break-inside: avoid;
    padding-bottom: 1.5rem;
  }

  .group[hidden] {
    display: none;
  }

  .group__artist {
    padding-bottom: 0.35rem;
    margin-bottom: 0.35rem;
    border-bottom: 2px solid var(--ink);
    font: 800 1.35rem/1.15 var(--font-display);
    text-transform: uppercase;
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .song {
    padding-block: 0.3rem;
    border-bottom: 1px solid rgb(26 22 18 / 0.12);
  }

  .song[hidden] {
    display: none;
  }

  .songs__empty {
    font-size: 1.125rem;
  }

  .songs__print {
    display: none;
  }

  @media print {
    .songs__groups {
      columns: 2;
    }

    .songs__print {
      display: block;
      margin-top: 2rem;
      padding-top: 1rem;
      border-top: 1px solid #000;
    }
  }
</style>
