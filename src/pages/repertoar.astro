---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageTitle from '../components/PageTitle.astro';
import { getSettings, getSongs } from '../content';
import { bookingHref } from '../site';

const songs = await getSongs();
const settings = await getSettings();
---

<Base
  page="repertoar"
  title="Repertoár"
  description="Co Exhalace hraje: předělávky českých a slovenských rockových a punkových kapel. Seznam k tisku pro pořadatele."
>
  <PageTitle title="Setlist">
    <p class="lead">Skladby, které od nás uslyšíte.</p>
  </PageTitle>

  <section class="section-tight wrap narrow" aria-labelledby="list-title">
    <div class="songs glass" data-reveal>
      <div class="songs__head no-print">
        <h2 id="list-title" class="sr-only">
          Seznam skladeb
        </h2>
        <label class="search" hidden>
          <span class="sr-only">Hledat píseň nebo kapelu</span>
          <Icon name="search" />
          <input
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Hledat píseň nebo kapelu"
          />
        </label>
        <button class="btn btn--ghost" type="button" data-print>
          <Icon name="printer" /> Vytisknout
        </button>
      </div>
      <p class="songs__count meta no-print" aria-live="polite"></p>
      <ul class="songs__list">
        {songs.map((s) => (
          <li class="song" data-q={`${s.title} ${s.artist}`}>
            <span class="song__title">{s.title}</span>
            <span class="song__artist">{s.artist}</span>
          </li>
        ))}
      </ul>
      <p class="songs__empty dim" hidden>
        Nic takového nehrajeme. Zkuste jiný název.
      </p>
      <p class="songs__teaser">A další pecky pro vás připravujeme…</p>
      <p class="songs__print">
        Objednávky: {settings.phone} · {settings.email} · www.exhalace.cz
      </p>
    </div>
    <div class="section-foot no-print">
      <a class="btn" href={bookingHref}>
        Poptat koncert
      </a>
    </div>
  </section>
</Base>

<script>
  // Print button and a diacritics-insensitive filter: "zizen" finds "Žízeň".
  document.querySelector('[data-print]')?.addEventListener('click', () => print());

  const search = document.querySelector<HTMLLabelElement>('.search');
  const input = search?.querySelector('input');
  const count = document.querySelector('.songs__count');
  const empty = document.querySelector<HTMLElement>('.songs__empty');
  const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const songs = [...document.querySelectorAll<HTMLElement>('.song')].map((el) => ({
    el,
    q: fold(el.dataset.q ?? ''),
  }));

  if (search && input && count && empty) {
    search.hidden = false;
    let timer = 0;
    input.addEventListener('input', () => {
      const q = fold(input.value.trim());
      let shown = 0;
      for (const s of songs) {
        const hit = !q || s.q.includes(q);
        s.el.hidden = !hit;
        if (hit) shown++;
      }
      empty.hidden = shown > 0;
      // Announce the result once typing pauses, not on every key.
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        count.textContent = q ? `Nalezeno: ${shown}` : '';
      }, 400);
    });
  }
</script>

<style>
  .narrow {
    width: min(100%, 64rem);
  }

  .section-tight {
    padding-bottom: var(--section);
  }

  .songs {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background:
      radial-gradient(circle at 10% 0%, rgb(255 79 132 / 0.1), transparent 40%),
      radial-gradient(circle at 90% 100%, rgb(64 165 255 / 0.08), transparent 40%), var(--surface);
  }

  .songs__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 18rem;
    max-width: 26rem;
    min-height: 3rem;
    padding-inline: 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.25);
    transition: border-color 0.3s var(--ease);
  }

  .search[hidden] {
    display: none;
  }

  .search:focus-within {
    border-color: #fff;
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .search input {
    width: 100%;
    min-height: 2.75rem;
    border: 0;
    background: none;
    font-size: 1rem;
    outline: none;
  }

  .search input::placeholder {
    color: var(--faint);
  }

  .songs__count:empty {
    display: none;
  }

  .songs__list {
    display: grid;
    gap: 0.75rem;
  }

  @media (width >= 56rem) {
    .songs__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* The first site's glass rows: "Song – Artist" on one line, lifted with a light sweep. */
  .song {
    position: relative;
    display: block;
    overflow: hidden;
    padding: 1rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.04);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #f8f8f8;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .song:nth-child(odd) {
    background: rgb(255 255 255 / 0.03);
  }

  .song::after {
    content: '';
    position: absolute;
    inset: -6px;
    background: linear-gradient(120deg, transparent, rgb(255 255 255 / 0.14), transparent);
    transform: translateX(-120%);
    opacity: 0;
    pointer-events: none;
  }

  .song:hover {
    transform: translateY(-4px);
    border-color: rgb(255 255 255 / 0.16);
    box-shadow: 0 16px 36px rgb(0 0 0 / 0.35);
  }

  .song:hover::after {
    opacity: 1;
    animation: sweep 0.9s ease forwards;
  }

  .song[hidden] {
    display: none;
  }

  .song__artist::before {
    content: ' – ';
  }

  .song__artist {
    color: var(--dim);
  }

  .songs__teaser {
    margin-top: 0.5rem;
    color: var(--dim);
    text-align: center;
  }

  .songs__print {
    display: none;
  }

  @media print {
    .songs__list {
      grid-template-columns: 1fr 1fr;
    }

    /* The printed setlist ignores the search filter. */
    .song[hidden] {
      display: block;
    }

    .songs__empty {
      display: none;
    }

    .song {
      border: 0;
      border-bottom: 1px solid #ccc;
      border-radius: 0;
      padding: 0.3rem 0;
    }

    .songs__print {
      display: block;
      padding-top: 1rem;
      border-top: 1px solid #000;
    }
  }
</style>
