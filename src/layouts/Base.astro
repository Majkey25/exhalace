---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import { marks, type Mark as MarkName } from '../brand';
import { getAbout, getSettings } from '../content';
import { bookingHref, href, nav, type Page } from '../site';

interface Props {
  /** Current page for the nav; the home page passes 'home', utility pages nothing. */
  page?: Page | 'home';
  title?: string;
  description?: string;
  /** The home page plays the logo intro once per session. */
  intro?: boolean;
  /** Utility pages (404, thank you) stay out of search results. */
  noindex?: boolean;
  /** Brand marks the page uses besides the logo; each traced path weighs 18–30 KB. */
  extraMarks?: Exclude<MarkName, 'logo'>[];
}

const { page, title, description, intro = false, noindex = false, extraMarks = [] } = Astro.props;
const symbols: MarkName[] = ['logo', ...extraMarks];
const settings = await getSettings();
const about = await getAbout();
const site = Astro.site ?? new URL('https://www.exhalace.cz');
const url = (path: string) => new URL(path, site).href;
const pageTitle = title ? `${title} — Exhalace` : `Exhalace — ${settings.slogan.toLowerCase()}`;
const pageDescription =
  description ??
  `Exhalace, rocková kapela (${about.home}). Předělávky známých i méně známých českých a slovenských rockových a punkových kapel. Energická a poctivá show na každou akci.`;
const socials = (
  [
    { name: 'Facebook', url: settings.facebook, icon: 'facebook' },
    { name: 'Instagram', url: settings.instagram, icon: 'instagram' },
    { name: 'YouTube', url: settings.youtube, icon: 'youtube' },
  ] as const
).filter((s): s is typeof s & { url: string } => Boolean(s.url));
const tel = settings.phone?.replace(/\s/g, '');
// Prerender a page when the visitor hovers its link, so navigation feels instant (Chromium).
const speculation = {
  prerender: [{ where: { href_matches: href('*') }, eagerness: 'moderate' }],
};
const ld = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Exhalace',
  alternateName: ['EXHALACE', 'STAGE'],
  url: url(href()),
  image: url(href('og.jpg')),
  genre: ['Rock', 'Punk rock'],
  foundingDate: about.founded,
  location: { '@type': 'Place', name: `${about.home}, Česko` },
  email: settings.email,
  ...(tel && { telephone: tel }),
  sameAs: socials.map((s) => s.url),
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    {page && <link rel="canonical" href={url(Astro.url.pathname)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Exhalace" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={url(Astro.url.pathname)} />
    <meta property="og:image" content={url(href('og.jpg'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="cs_CZ" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font" preload={[{ subset: 'latin' }]} />
    <link
      rel="preload"
      href={href('fonts/farcry.woff2')}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          if (sessionStorage.getItem('exh-intro')) d.classList.add('no-intro');
          else sessionStorage.setItem('exh-intro', '1');
        } catch {
          d.classList.add('no-intro');
        }
      })();
    </script>
    {page === 'home' && (
      <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
    )}
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />
  </head>
  <body>
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      {symbols.map((name) => (
        <symbol id={name} viewBox={marks[name].viewBox} set:html={marks[name].body} />
      ))}
    </svg>

    {intro && (
      <div class="intro" aria-hidden="true">
        <Mark name="logo" class="intro__logo" />
      </div>
    )}

    <a class="skip" href="#main">
      Přeskočit na obsah
    </a>

    <header class="header">
      <div class="header__bar">
        <a class="header__logo" href={href()} aria-label="Exhalace – úvod">
          <Mark name="logo" />
        </a>
        <nav class="header__nav" aria-label="Hlavní">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={href(`${n.key}/`)} aria-current={n.key === page ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="btn btn--solid header__cta" href={bookingHref}>
          Poptat koncert
        </a>
        <button class="btn btn--ghost header__menu" type="button" popovertarget="menu">
          <Icon name="menu" /> Menu
        </button>
      </div>
    </header>

    <nav id="menu" class="menu glass" popover aria-label="Menu">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={href(`${n.key}/`)} aria-current={n.key === page ? 'page' : undefined}>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--solid" href={bookingHref}>
        Poptat koncert
      </a>
      <button class="menu__close" type="button" popovertarget="menu" popovertargetaction="hide">
        <Icon name="close" />
        <span class="sr-only">Zavřít menu</span>
      </button>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer__card glass">
          <div class="footer__brand">
            <a class="footer__logo" href={href()} aria-label="Exhalace – úvod">
              <Mark name="logo" />
            </a>
            <p class="dim">{settings.slogan}</p>
            <ul class="footer__socials">
              {socials.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" target="_blank" aria-label={s.name}>
                    <Icon name={s.icon} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="footer__col">
            <p class="eyebrow">Kontakt</p>
            {tel && <a href={`tel:${tel}`}>{settings.phone}</a>}
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
            <a class="link-arrow" href={bookingHref}>
              Poptat koncert <Icon name="arrow-right" />
            </a>
          </div>
          <nav class="footer__col" aria-label="Patička">
            <p class="eyebrow">Web</p>
            {nav.map((n) => (
              <a href={href(`${n.key}/`)}>{n.label}</a>
            ))}
          </nav>
        </div>
        <div class="footer__row">
          <p class="meta">© {new Date().getFullYear()} Exhalace</p>
          <a
            class="footer__chip"
            href="https://majkey25.github.io/init/"
            rel="noopener"
            target="_blank"
          >
            Made by Matěj Teplý
          </a>
          <a class="meta footer__top" href="#main">
            Nahoru <Icon name="arrow-up" />
          </a>
        </div>
      </div>
    </footer>

    <script>
      // Intro: any input skips it; it leaves the DOM once it has faded out.
      const intro = document.querySelector('.intro');
      if (intro) {
        const done = () => intro.remove();
        if (document.documentElement.classList.contains('no-intro')) done();
        intro.addEventListener('animationend', (e) => e.target === intro && done());
        for (const type of ['pointerdown', 'keydown', 'wheel', 'touchmove'])
          addEventListener(type, done, { once: true, passive: true });
      }

      // Mobile menu: close once a link is picked.
      const menu = document.getElementById('menu');
      menu?.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a')) menu.hidePopover();
      });
    </script>
  </body>
</html>

<style>
  /* ---------- Intro: the logo rises, then opens up and dissolves into the page ---------- */

  .intro {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: grid;
    place-items: center;
    background: #0d0d0d;
    pointer-events: none;
    animation: intro-out 0.7s ease-out 1.65s forwards;
  }

  :global(.no-intro) .intro,
  :global(html:not(.js)) .intro {
    display: none;
  }

  .intro__logo {
    width: min(84vw, 44rem);
    height: auto;
    color: #fff;
    animation:
      logo-in 0.9s var(--ease) 0.15s both,
      logo-out 0.9s cubic-bezier(0.2, 0, 0.8, 1) 1.5s forwards;
  }

  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateY(1.75rem);
    }
  }

  @keyframes logo-out {
    to {
      opacity: 0;
      transform: scale(1.4);
      filter: blur(6px);
    }
  }

  @keyframes intro-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }

  /* ---------- Header: a floating glass bar ---------- */

  .header {
    position: fixed;
    inset: 0.75rem 0 auto;
    z-index: 100;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
    view-transition-name: header;
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(100%, 80rem);
    min-height: 3.5rem;
    margin-inline: auto;
    padding: 0.4rem 0.5rem 0.4rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(13 13 13 / 0.72);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.35);
  }

  .header__logo {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: #fff;
  }

  .header__logo svg {
    width: auto;
    height: 1.4rem;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .header__nav a,
  .menu a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .header__nav a:hover,
  .menu a:not(.btn):hover {
    background: rgb(255 255 255 / 0.1);
  }

  .header__nav a[aria-current='page'],
  .menu a[aria-current='page'] {
    background: rgb(255 255 255 / 0.14);
  }

  .header__cta,
  .header__menu {
    min-height: 2.75rem;
    padding: 0.5rem 1.2rem;
    font-size: 0.9rem;
  }

  .header__menu {
    display: none;
    margin-left: auto;
  }

  @media (width < 60rem) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__menu {
      display: inline-flex;
    }
  }

  /* ---------- Mobile menu (native popover) ---------- */

  .menu {
    inset: 5rem 0.75rem auto;
    width: auto;
    margin: 0;
    padding: 1.25rem;
    background: rgb(13 13 13 / 0.94);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    color: var(--text);
    opacity: 0;
    transform: translateY(-0.75rem);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease),
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }

  .menu:popover-open {
    display: grid;
    gap: 1rem;
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .menu:popover-open {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
  }

  .menu::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .menu ul {
    display: grid;
  }

  .menu a:not(.btn) {
    width: 100%;
    font-size: 1.1rem;
  }

  .menu__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
  }

  .menu__close:hover {
    background: rgb(255 255 255 / 0.1);
  }

  /* ---------- Footer ---------- */

  .footer {
    padding-block: var(--section) 1.5rem;
  }

  .footer__card {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .footer__brand {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .footer__logo {
    color: #fff;
    justify-self: start;
  }

  .footer__logo svg {
    width: min(16rem, 100%);
    height: auto;
  }

  .footer__socials {
    display: flex;
    gap: 0.5rem;
  }

  .footer__socials a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .footer__socials a:hover {
    background: #fff;
    color: #0d0d0d;
  }

  .footer__socials .icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .footer__col {
    display: grid;
    align-content: start;
    justify-items: start;
  }

  .footer__col .eyebrow {
    margin-bottom: 0.5rem;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--dim);
    transition: color 0.3s var(--ease);
  }

  .footer__col a:hover {
    color: #fff;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1.5rem;
  }

  /* The first site's credit chip. */
  .footer__chip {
    padding: 0.35rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    font-size: 0.875rem;
    transition: background-color 0.3s var(--ease);
  }

  .footer__chip:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
  }

  @media (width < 48rem) {
    .footer__card {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
