---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
// Not every video has a max-resolution thumbnail; fall back to the one that always exists.
const max = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const ok = await fetch(max, { method: 'HEAD' }).then(
  (r) => r.ok,
  () => false,
);
const thumb = ok ? max : `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="video">
  {/* YouTube loads only after a click: no third-party requests or cookies before that.
      Without JS the link simply opens the video on YouTube. */}
  <a
    class="video__play"
    href={`https://www.youtube.com/watch?v=${id}`}
    data-video={id}
    aria-label={`Přehrát video: ${title}`}
  >
    <Picture
      src={thumb}
      inferSize
      formats={['avif']}
      fallbackFormat="webp"
      widths={[480, 800, 1280]}
      sizes="(width >= 64rem) 60rem, 100vw"
      alt=""
    />
    <span class="video__btn">
      <Icon name="play" />
    </span>
  </a>
</div>
<p class="video-privacy">
  Přehrání videa naváže spojení s YouTube. Google obdrží vaši IP adresu a údaje o prohlížeči a může
  ukládat data do zařízení.
  <a href="https://policies.google.com/privacy">Zásady ochrany soukromí Google</a>.
</p>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-video]').forEach((link) =>
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.video}?autoplay=1&rel=0`;
      frame.title = link.getAttribute('aria-label') ?? 'Video';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      link.replaceWith(frame);
      frame.focus();
    }),
  );
</script>

<style>
  .video-privacy {
    margin-top: 1rem;
    color: var(--dim);
  }

  .video-privacy a {
    text-decoration: underline;
  }

  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }

  .video__play,
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__play :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8);
    transition:
      filter 0.5s var(--ease),
      transform 0.8s var(--ease);
  }

  .video__btn {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: #fff;
    color: #0d0d0d;
    translate: -50% -50%;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 0.3);
    transition: box-shadow 0.5s var(--ease);
  }

  .video__btn :global(.icon) {
    width: 1.75rem;
    height: 1.75rem;
    fill: currentColor;
    translate: 0.1rem 0;
  }

  .video__play:hover :global(img) {
    filter: brightness(1);
    transform: scale(1.02);
  }

  .video__play:hover .video__btn {
    box-shadow: 0 0 0 1.1rem rgb(255 255 255 / 0.15);
  }
</style>
